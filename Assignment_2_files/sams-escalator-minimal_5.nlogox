<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[;; =======================================================================================
;; HOLBORN UNDERGROUND ESCALATOR PARADOX - 
;; =======================================================================================
;; An Agent-Based Model of Walking vs Standing Throughput on London Underground Escalators
;;
;; Goal: To investigate the counter-intuitive finding that prohibiting walking on escalators
;; can increase the overall throughput during peak hours. 
;;
;; Research Question: How does the proportion of walking versus standing commuters affect escalator 
;; throughput, and under what conditions does a standing-only policy outperform a mixed-behaviour 
;; regime?

;; Physical calibration:
;;   1 tick = 0.533 seconds (time for escalator to advance 1 step)
;;   1 patch = 1 escalator step = 0.4m depth
;;   Estimated 60 steps for the Holborn escalator = 24m depth. 
;;   Escalator speed = 0.75 m/s = 1 patch/tick
;;   Walker extra speed = ~0.5 m/s on stairs = 1 extra patch/tick
;;   1 minute = 113 ticks
;; =======================================================================================

globals [
  ;; Set geometry
  escalator-bottom-y
  escalator-top-y
  left-lane-x              ;; standing lane (x=0)
  right-lane-x             ;; walking lane (x=1)
  concourse-bottom-y
  concourse-top-y

  ;; Time
  ticks-per-minute          ;; 113
  rush-hour-start           ;; tick 3390 (08:30)
  rush-hour-end             ;; tick 10170 (09:30)
  sim-end-tick              ;; tick 13560 (10:00)

  ;; Train system
  next-train-tick           ;; arrival of underground train at rush-hour start
  demand-pool               ;; passengers waiting to enter concourse

  ;; Metrics
  total-completed
  rush-hour-completed
  throughput-per-minute
  max-peak-throughput
  tick-window-completed

  ;; Rolling averages
  wait-time-list            ;; spawn-to-boarding durations
  travel-time-list          ;; spawn-to-exit durations
  mean-wait-time
  mean-travel-time

  ;; Peak-hour average throughput
  rush-hour-throughput-sum   ;; sum of all per-minute throughputs during rush hour
  rush-hour-minute-count     ;; number of minutes measured during rush hour
  
  lane-discipline-threshold
]

turtles-own [
  walk-speed                ;; extra patches/tick beyond escalator (0 for standers)
  arrival-tick              ;; when spawned
  agent-state               ;; "approaching" | "queueing" | "on-escalator"
  preferred-lane-x
  blocked-ticks             ;; how many ticks waiting to board preferred lane
  is-walker?
  stepped-last?
  position-on-step
  dist-to-preferred
  fed-up?
]

patches-own [
  patch-type                ;; "escalator-left" | "escalator-right" | "concourse" |
                            ;; "marshalling" | "background" | "exit-zone" | "spawn"
  is-step?
  step-number
  dist-to-escalator         ;; Dijkstra distance
  path-selected?
  dist-to-left
  dist-to-right
]

;; =======================================================================================
;; SETUP
;; =======================================================================================
to setup
  clear-all

  ;; Time
  set ticks-per-minute 113
  set rush-hour-start (30 * ticks-per-minute)
  set rush-hour-end (90 * ticks-per-minute)
  set sim-end-tick (120 * ticks-per-minute)

  ;; Train timing: fixed interval, first train at rush hour start
  set next-train-tick rush-hour-start
  set demand-pool []

  ;; Counters
  set total-completed 0
  set rush-hour-completed 0
  set throughput-per-minute 0
  set tick-window-completed 0
  set wait-time-list []
  set travel-time-list []
  set mean-wait-time 0
  set mean-travel-time 0
  set max-peak-throughput 0
  set rush-hour-throughput-sum 0
  set rush-hour-minute-count 0

  ;; Geometry
  set left-lane-x 0
  set right-lane-x 1
  set escalator-bottom-y 0
  set escalator-top-y (escalator-length - 1)
  set concourse-top-y -1
  set concourse-bottom-y (concourse-top-y - 25 + 1) ;; Set concourse size to 25 

  resize-world -19 20 (concourse-bottom-y - 1) (escalator-top-y + 3)

  ;; ---- Patches ----
  ask patches [
    set patch-type "background"
    set is-step? false
    set step-number -1
    set dist-to-escalator 1000000
    set path-selected? false
    set pcolor grey - 3.5
  ]

  ;; Escalator left lane
  ask patches with [pxcor = left-lane-x and pycor >= escalator-bottom-y and pycor <= escalator-top-y] [
    set patch-type "escalator-left"
    set is-step? true
    set step-number (pycor - escalator-bottom-y)
    set pcolor 95 - 1
  ]

  ;; Escalator right lane
  ask patches with [pxcor = right-lane-x and pycor >= escalator-bottom-y and pycor <= escalator-top-y] [
    set patch-type "escalator-right"
    set is-step? true
    set step-number (pycor - escalator-bottom-y)
    set pcolor 95 - 2
  ]

  ;; Boundary rails
  ask patches with [(pxcor = left-lane-x - 1 or pxcor = right-lane-x + 1) and
                     pycor >= escalator-bottom-y and pycor <= escalator-top-y] [
    set patch-type "boundary"
    set pcolor grey
  ]

  ;; Marshalling zone (funnel toward escalator)
  ask patches with [pxcor >= (left-lane-x - 1) and pxcor <= (right-lane-x + 1) and pycor = -1] [
    set patch-type "marshalling"
    set pcolor 34
  ]
  ask patches with [pxcor >= (left-lane-x - 2) and pxcor <= (right-lane-x + 2) and pycor = -2] [
    if patch-type != "marshalling" [ set patch-type "marshalling" set pcolor 33.5 ]
  ]
  ask patches with [pxcor >= (left-lane-x - 3) and pxcor <= (right-lane-x + 3) and pycor = -3] [
    if patch-type != "marshalling" [ set patch-type "marshalling" set pcolor 33 ]
  ]
  ask patches with [pxcor >= (left-lane-x - 4) and pxcor <= (right-lane-x + 4) and pycor = -4] [
    if patch-type != "marshalling" [ set patch-type "marshalling" set pcolor 32.5 ]
  ]

  ;; Concourse
  ask patches with [pxcor >= -14 and pxcor <= 15 and pycor >= concourse-bottom-y and pycor <= -5] [
    if patch-type = "background" [ set patch-type "concourse" set pcolor 32 ]
  ]

  ;; Spawn zone (bottom 10 rows)
  ask patches with [pxcor >= -14 and pxcor <= 15 and
                     ;pycor >= concourse-bottom-y and pycor <= concourse-bottom-y + 9] [
                    pycor = concourse-bottom-y][
    set patch-type "spawn"
    set pcolor 31
  ]

  ;; Exit zone
  ask patches with [pxcor >= left-lane-x and pxcor <= right-lane-x and
                     pycor > escalator-top-y and pycor <= escalator-top-y + 2] [
    set patch-type "exit-zone"
    set pcolor 55 - 2
  ]

  ;; Dijkstra
  compute-distance-field
  
  
  set lane-discipline-threshold (ticks-per-minute * lane-discipline-seconds / 60)

  reset-ticks
end

;; =======================================================================================
;; DIJKSTRA (SHORTEST PATH)
;; =======================================================================================
;; This segment computes the shortest distance from walkable patches to the escalator 
;; =======================================================================================
to compute-distance-field

  let walkable-types ["concourse" "marshalling" "spawn"]
  
  ask patches with [member? patch-type walkable-types]
  [
    set dist-to-escalator min (list (distance patch left-lane-x -1) (distance patch right-lane-x -1))
    
    let left-secret-sauce max (list (pxcor - left-lane-x) 0) / sqrt (sqrt (0 - pycor))
    let right-secret-sauce max (list (right-lane-x - pxcor) 0) / sqrt (sqrt (0 - pycor))
    
    let left-line abs ((.6 * (pycor + 1) - (pxcor - left-lane-x)))
    let right-line abs ((.6 * (pycor + 1) + (pxcor - right-lane-x)))
    
    set dist-to-left distance (patch left-lane-x -1) + 4 * left-secret-sauce + left-line
    set dist-to-right distance (patch right-lane-x -1) + 4 * right-secret-sauce + right-line
    ;set pcolor .1 * dist-to-right
  ]
end

;; =======================================================================================
;; GO
;; (1) ARRIVAL (2) APPROACH (3) BOARDING (4) MOVEMENT (5) EXIT (6) UPDATE METRICS
;; =======================================================================================
to go
  if ticks >= sim-end-tick [ stop ]

  ;submodel-arrival
  ;submodel-approach
  ;submodel-exit
  ;submodel-movement
  ;submodel-boarding
  
  
  submodel-exit
  submodel-movement
  submodel-boarding
  submodel-approach
  submodel-arrival
  
  update-metrics
  
  ;print (list left-clear-steps right-clear-steps)

  tick
end

;; =======================================================================================
;; (1) ARRIVAL
;; =======================================================================================
;; Segment generates commuter arrivals onto the concourse, representing both peak-period
;; train unloadings and off-peak background flow.
;;
;; Key mechanisms:
;; 1. Rush hour arrivals occur in discrete batches at fixed time intervals, approximating
;;    train arrivals and platform clearance.
;; 2. When inflow exceeds available space, commuters accumulate in a "demand pool", 
;;    representing platform congestion and delayed entry.
;; 3. The demand pool is gradually released into the concourse at a capped spawn rate, 
;;    introducing a realistic bottleneck at entry points.
;; 4. Off-peak arrivals follow a low-probability stochastic process, simulating background 
;;     passenger trickle.
;; =======================================================================================

to submodel-arrival
  ;; (1A) Rush hour: trains arrive - Add arrival timestamps to the list
  if ticks >= rush-hour-start and ticks <= rush-hour-end [
    if ticks >= next-train-tick [
      repeat batch-size [
        set demand-pool lput ticks demand-pool
      ]
      set next-train-tick ticks + (train-interval-minutes * ticks-per-minute)
    ]
  ]

  ;; (1B) Off-peak: arrivals
  if ticks < rush-hour-start or ticks > rush-hour-end [
    if random ticks-per-minute < off-peak-rate [
      set demand-pool lput ticks demand-pool
    ]
  ]

  ;; (1C) Spawning Logic - Use the list length as count
  let to-spawn min (list (length demand-pool) 30) ;; allow up to 30 agents to spawn per tick
  
  repeat to-spawn [
    let spawn-patches patches with [patch-type = "spawn" and not any? turtles-here]
    
    ifelse any? spawn-patches [
      ;; Get the OLDEST arrival time from the front of the list
      let true-arrival-time item 0 demand-pool
      set demand-pool but-first demand-pool
      
      ask one-of spawn-patches [
        sprout 1 [
          set shape "person"
          set size 0.85
          set arrival-tick true-arrival-time  ;; Use the time they entered the platform
          set agent-state "approaching"
          set blocked-ticks 0
          set heading 0

          ;; (1D) Attribute assignment (Walker vs Stander)
          set is-walker? (random-float 100 < pct-walkers)

          ifelse is-walker? [
            set walk-speed random-normal walk-speed-average walk-speed-std
            set color yellow
            ;; Lane Logic
            ifelse pct-walkers = 100 
              [ set preferred-lane-x one-of (list left-lane-x right-lane-x) ]
              [ set preferred-lane-x left-lane-x ]
          ] [
            set walk-speed 0
            set color cyan
            ;; Lane Logic
            ifelse pct-walkers = 0 
              [ set preferred-lane-x one-of (list left-lane-x right-lane-x) ]
              [ set preferred-lane-x right-lane-x ]
          ]
          ifelse preferred-lane-x = left-lane-x
          [
            set dist-to-preferred distance (patch left-lane-x -1)
          ]
          [
            set dist-to-preferred distance (patch right-lane-x -1)
          ]  
          set fed-up? false
        ]
      ]
    ] [
      ;; If no space in spawn patches, stop spawning for this tick
      stop 
    ]
  ]
end

;; ============================================================================
;; (2) APPROACH (Dijkstra pathfinding)
;; ============================================================================
;; Agents follow the distance gradient toward the escalator. They transition to 
;; "queueing" when they enter the marshalling zone,not just at the two gate 
;; patches. This prevents the funnel from becoming an artificial bottleneck — 
;; in reality, people crowd around the escalator entrance, and whoever is 
;; closest steps on.
;; ============================================================================

to submodel-approach
  
  let on-approach sort-by [[a b] -> [dist-to-preferred] of a < [dist-to-preferred] of b] turtles with [agent-state = "approaching"]
  foreach on-approach [ agent ->
  ask agent [
      

    ;; In marshalling zone? transition to queueing
    ;if [patch-type] of patch-here = "marshalling" [
    ;  set agent-state "queueing"
    ;  stop
    ;]

    ;; Follow gradient
    let walkable-neighbours neighbors with [
      (patch-type = "concourse" or patch-type = "marshalling" or patch-type = "spawn") and
      not any? turtles-here
    ]
      
    let moving? false
     
    let best patch-here
      
    if (any? walkable-neighbours) [
      let current-left [dist-to-left] of best
      let current-right [dist-to-right] of best
        
      let best-left min-one-of walkable-neighbours [dist-to-left]
      let left-dist [dist-to-left] of best-left
        
      let best-right min-one-of walkable-neighbours [dist-to-right]
      let right-dist [dist-to-right] of best-right
        
      ifelse fed-up?
      [
        ifelse (left-dist < right-dist)
        [
          if (left-dist < current-left)
          [
            set moving? true
            set best best-left
            set dist-to-preferred distance (patch left-lane-x -1)
          ]
        ]
        [
          if (right-dist < current-left)
          [
            set moving? true
            set best best-right
            set dist-to-preferred distance (patch right-lane-x -1)
          ]
        ]
      ]
      [
        ifelse preferred-lane-x = left-lane-x
        [
          if (left-dist < current-left)
          [
            set moving? true
            set best best-left
            set dist-to-preferred distance (patch left-lane-x -1)
          ]
        ]
        [
          if (right-dist < current-right)
          [
            set moving? true
            set best best-right
            set dist-to-preferred distance (patch right-lane-x -1)
          ]
        ]
      ]
    ]
    ifelse moving?
    [
      move-to best
    ]
    [
      set blocked-ticks blocked-ticks + 1
    ]
    set fed-up? (blocked-ticks > lane-discipline-threshold)
    if fed-up?
    [
      set color red  
    ]
    ]
  ]
end


;; ============================================================================
;; (3) BOARDING
;; ============================================================================
;; Governs how agents transition from the concourse queue onto the escalator.
;;
;; CORE MECHANICS:
;; 1. Agents are processed in order of proximity to the escalator, then FIFO.
;; 2. Each agent attempts to board their preferred lane first.
;; 3. Boarding is only possible if the bottom N steps of the lane are empty,
;;    where N = step-gap (encodes capacity constraints).
;; 4. If blocked, agents wait and may switch lanes after a delay.
;; 5. Upon boarding, agents adopt the behaviour (walking/standing) appropriate
;;    to the lane they enter.
;;
;; GAP REQUIRED:
;; - step-gap-stand = 2 → dense packing (~56 pax/min/lane)
;; - step-gap-walk  = 3 → lower density (~38 pax/min/lane)
;;
;; BEHAVIOURAL RULES:
;; - Mixed regime: walkers prefer right lane, standers prefer left lane
;; - Standing-only (pct-walkers = 0): no lane discipline → both lanes used
;; - Lane switching occurs only after waiting (lane-discipline threshold)
;;
;; This structure allows congestion and throughput to emerge endogenously.
;; ============================================================================
to submodel-boarding
  let my-patch-set (patch-set patch left-lane-x -1 patch right-lane-x -1)
  foreach (list turtles-on my-patch-set) [ agent ->
    ask agent [
      board-lane
    ]
  ]
end


to-report board-lane? [alt-ok?]
  let space-to-step-into 0
  let alt-space-to-step-into 0
  let alt-lane-x 0
  ifelse preferred-lane-x = left-lane-x
  [
    set alt-lane-x right-lane-x
  ]
  [
    set alt-lane-x left-lane-x
  ]
  
  
  set space-to-step-into ( clear-steps preferred-lane-x escalator-bottom-y )
  set alt-space-to-step-into ( clear-steps alt-lane-x escalator-bottom-y )
  
  ifelse is-walker?
  [
    if space-to-step-into > step-gap-walk
    [
      move-to patch preferred-lane-x (escalator-bottom-y + 1)
      set-junk
      report true
    ]
    if space-to-step-into = step-gap-walk
    [
      move-to patch preferred-lane-x escalator-bottom-y
      set-junk
      report true
    ]
    
    if (alt-space-to-step-into > step-gap-walk and alt-ok?)
    [
      move-to patch alt-lane-x (escalator-bottom-y + 1)
      set-junk
      report true
    ]
    if (alt-space-to-step-into = step-gap-walk and alt-ok?)
    [
      move-to patch alt-lane-x escalator-bottom-y
      set-junk
      report true
    ]
  ]
  
  [
    if space-to-step-into >= step-gap-stand
    [
      move-to patch preferred-lane-x escalator-bottom-y
      set-junk
      report true
    ]
    if (alt-space-to-step-into >= step-gap-stand and alt-ok?)
    [
      move-to patch alt-lane-x escalator-bottom-y
      set-junk
      report true
    ]
  ]
  report false
end

to board-lane
  let space-to-step-into 0
  let my-x [pxcor] of patch-here
  set space-to-step-into ( clear-steps my-x escalator-bottom-y )
  
  ifelse is-walker?
  [
    if space-to-step-into > step-gap-walk
    [
      move-to patch my-x (escalator-bottom-y + 1)
      set-junk
    ]
    if space-to-step-into = step-gap-walk
    [
      move-to patch my-x escalator-bottom-y
      set-junk
    ]
    if (space-to-step-into = step-gap-stand and fed-up?)
    [
      move-to patch my-x escalator-bottom-y
      set-junk
    ]
  ]
  [
    if space-to-step-into >= step-gap-stand
    [
      move-to patch my-x escalator-bottom-y
      set-junk
    ]
  ]
end

to set-junk
  set agent-state "on-escalator"                 ;; change the state of the agent 
  set stepped-last? true

  ;; Record wait time
  let wait-dur (ticks - arrival-tick)
  set wait-time-list lput wait-dur wait-time-list
  if length wait-time-list > 1500 [
    set wait-time-list sublist wait-time-list (length wait-time-list - 1500) (length wait-time-list)
  ]
end


;; Helper: get patch-here for sorting
to-report patch-here-of [agent]
  report [patch-here] of agent
end


;; ============================================================================
;; (4) MOVEMENT
;; ============================================================================
;; Escalator carries all agents 1 step/tick (mechanical).
;; Walkers ADDITIONALLY take 1 extra step with probability walk-speed%.
;; This models fractional walking speeds:
;;   walk-speed=100 → always step (total 1.5 m/s)
;;   walk-speed=66  → 66% chance (total ~1.25 m/s)
;;   walk-speed=50  → 50% chance (total ~1.13 m/s)
;; Only blocked by agents in the SAME lane ahead.
;; ============================================================================
to submodel-movement
  let on-esc sort-by [[a b] -> [ycor] of a > [ycor] of b] turtles with [agent-state = "on-escalator"]

  foreach on-esc [ agent ->
    ask agent [
      if pycor >= escalator-top-y [ stop ]

      ;; Escalator mechanical movement (1 step/tick)
      let space-to-move 0
      ifelse (stepped-last? or (not is-walker?))
      [
        set space-to-move (clear-steps pxcor (pycor + 1)) - step-gap-stand + 1
      ]
      [
        set space-to-move (clear-steps pxcor (pycor + 1)) - step-gap-walk + 1
      ]
      let max-steps (int walk-speed) + 1
      if max-steps = (walk-speed + 1)
      [
        set max-steps max-steps - 1
      ]
      set position-on-step min (list (position-on-step + walk-speed) max-steps)
      let preferred-move-amount 1 + position-on-step
      let actual-move-amount min (list space-to-move (round preferred-move-amount))
      
      set actual-move-amount max (list actual-move-amount 1)
      
      set stepped-last? (actual-move-amount > 1)
      
      let target-step patch pxcor (pycor + actual-move-amount)
      move-to target-step
      
    ]
  ]
end

;; ============================================================================
;; (5) EXIT
;; ============================================================================
to submodel-exit
  
  ;; Identify agents who have reached or passed the top of the escalator
  ask turtles with [agent-state = "on-escalator" and pycor >= escalator-top-y] [    
    
    ;; (5A) Calculate journey time (wait + travel on escalator)
    let tt (ticks - arrival-tick)
    set travel-time-list lput tt travel-time-list
    if length travel-time-list > 1500 [
      set travel-time-list sublist travel-time-list (length travel-time-list - 1500) (length travel-time-list)
    ]

    ;; (5B) Calculate throughput 
    set total-completed total-completed + 1
    set tick-window-completed tick-window-completed + 1

    ;; (5C) Track specific throughput performance during the defined rush-hour window
    if ticks >= rush-hour-start and ticks <= rush-hour-end [
      set rush-hour-completed rush-hour-completed + 1
    ]

    ;; (5D) Remove agents that have completed the process
    die
  ]
end

;; ============================================================================
;; (6) METRICS AND REPORTING
;; ============================================================================
to update-metrics
  ;; Per-minute throughput
  if ticks > 0 and ticks mod ticks-per-minute = 0 [
    set throughput-per-minute tick-window-completed

    ;; Track rush-hour average
    if ticks >= rush-hour-start and ticks <= rush-hour-end [
      set rush-hour-throughput-sum rush-hour-throughput-sum + throughput-per-minute
      set rush-hour-minute-count rush-hour-minute-count + 1
      
      if throughput-per-minute > max-peak-throughput [
        set max-peak-throughput throughput-per-minute
      ]
    ]

    set tick-window-completed 0
  ]

  ;; Rolling averages
  ifelse length wait-time-list > 0
    [ set mean-wait-time mean wait-time-list ]
    [ set mean-wait-time 0 ]

  ifelse length travel-time-list > 0
    [ set mean-travel-time mean travel-time-list ]
    [ set mean-travel-time 0 ]
end

;; REPORTERS
to-report current-time
  let total-minutes (ticks / ticks-per-minute) + (8 * 60)
  let hours floor (total-minutes / 60)
  let mins floor (total-minutes mod 60)
  report (word (ifelse-value (hours < 10) ["0"] [""]) hours ":"
               (ifelse-value (mins < 10) ["0"] [""]) mins)
end

to-report is-rush-hour?
  report (ticks >= rush-hour-start and ticks <= rush-hour-end)
end

to-report on-escalator-count
  report count turtles with [agent-state = "on-escalator"]
end

to-report avg-peak-throughput
  ;; Average throughput per minute during rush hour only
  ifelse rush-hour-minute-count > 0
    [ report precision (rush-hour-throughput-sum / rush-hour-minute-count) 1 ]
    [ report 0 ]
end

to-report max-rush-throughput
  report max-peak-throughput
end

to-report rush-hour-total
  report rush-hour-completed
end

to-report total-served
  report total-completed
end

to-report mean-wait-seconds
  report precision (mean-wait-time * 0.533) 1
end

to-report mean-travel-seconds
  report precision (mean-travel-time * 0.533) 1
end

to-report current-throughput
  report throughput-per-minute
end

to-report demand-pool-size
  report length demand-pool
end

to-report clear-steps [start-x start-y]
  let num-to-check escalator-bottom-y + escalator-length + 3 - start-y
  foreach range num-to-check [ step ->
    let p patch start-x (start-y + step)    
    if p = nobody or any? turtles-on p [              
      report step                                  
    ]        
  ]
  report num-to-check
end]]></code>
  <widgets>
    <view x="208" wrappingAllowedX="false" y="9" frameRate="30.0" minPycor="-26" height="827" showTickCounter="true" patchSize="8.28" fontSize="10" wrappingAllowedY="false" width="373" tickCounterLabel="ticks" maxPycor="62" updateMode="0" maxPxcor="20" minPxcor="-19"></view>
    <plot x="590" autoPlotX="true" yMax="120.0" autoPlotY="true" yAxis="Agents/Min" y="9" xMin="0.0" height="190" legend="false" xMax="120.0" yMin="0.0" width="400" xAxis="Ticks" display="Throughput Over Time">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="throughput" color="-13345367" legend="true">
        <setup></setup>
        <update><![CDATA[if ticks > 0 and ticks mod ticks-per-minute = 0 [ plot throughput-per-minute ]]]></update>
      </pen>
    </plot>
    <monitor x="995" precision="1" y="75" height="60" fontSize="11" width="207" display="Avg Peak Hr Throughput/min">avg-peak-throughput</monitor>
    <monitor x="995" precision="1" y="137" height="60" fontSize="11" width="206" display="Max Peak Hr Throughput">max-peak-throughput</monitor>
    <monitor x="1097" precision="0" y="12" height="60" fontSize="11" width="100" display="Rush Hour?">is-rush-hour?</monitor>
    <monitor x="995" precision="0" y="12" height="60" fontSize="11" width="100" display="Time">current-time</monitor>
    <plot x="592" autoPlotX="true" yMax="60.0" autoPlotY="true" yAxis="Seconds" y="205" xMin="0.0" height="190" legend="false" xMax="10000.0" yMin="0.0" width="400" xAxis="Ticks" display="Mean Wait Time">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="wait" color="-612749" legend="true">
        <setup></setup>
        <update><![CDATA[if length wait-time-list > 0 [ plot mean-wait-time * 0.533 ]]]></update>
      </pen>
    </plot>
    <monitor x="997" precision="0" y="203" height="60" fontSize="11" width="203" display="Rush Hr Customers Served">rush-hour-total</monitor>
    <monitor x="998" precision="0" y="267" height="60" fontSize="11" width="200" display="Total Customers Served">total-served</monitor>
    <monitor x="997" precision="0" y="332" height="60" fontSize="11" width="204" display="Demand Pool">demand-pool-size</monitor>
    <monitor x="997" precision="1" y="400" height="60" fontSize="11" width="185" display="Average Wait in Station (sec)">mean-wait-seconds</monitor>
    <monitor x="997" precision="1" y="465" height="60" fontSize="11" width="185" display="Avg Wait + Travel (sec)">mean-travel-seconds</monitor>
    <plot x="592" autoPlotX="true" yMax="120.0" autoPlotY="true" yAxis="Seconds" y="400" xMin="0.0" height="190" legend="false" xMax="10000.0" yMin="0.0" width="400" xAxis="Ticks" display="Mean Travel Time">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="travel" color="-10899396" legend="true">
        <setup></setup>
        <update><![CDATA[if length travel-time-list > 0 [ plot mean-travel-time * 0.533 ]]]></update>
      </pen>
    </plot>
    <button x="8" y="574" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="90" display="Setup">setup</button>
    <button x="104" y="575" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="90" display="Go">go</button>
    <slider x="10" step="5" y="67" max="60" width="190" display="escalator-length" height="50" min="20" direction="Horizontal" default="60.0" variable="escalator-length" units="steps"></slider>
    <slider x="10" step="5" y="10" max="100" width="190" display="pct-walkers" height="50" min="0" direction="Horizontal" default="40.0" variable="pct-walkers" units="%"></slider>
    <slider x="10" step="10" y="124" max="500" width="190" display="batch-size" height="50" min="50" direction="Horizontal" default="220.0" variable="batch-size" units="commuters"></slider>
    <slider x="10" step="0.5" y="181" max="5" width="190" display="train-interval-minutes" height="50" min="1" direction="Horizontal" default="2.0" variable="train-interval-minutes" units="min"></slider>
    <slider x="10" step="1" y="238" max="3" width="190" display="step-gap-stand" height="50" min="0" direction="Horizontal" default="2.0" variable="step-gap-stand" units="ticks"></slider>
    <slider x="10" step="1" y="295" max="4" width="190" display="step-gap-walk" height="50" min="0" direction="Horizontal" default="3.0" variable="step-gap-walk" units="ticks"></slider>
    <slider x="9" step="0.05" y="349" max="1.5" width="190" display="walk-speed-average" height="50" min="0.5" direction="Horizontal" default="1.0" variable="walk-speed-average" units="step/tick"></slider>
    <slider x="9" step=".01" y="406" max="0.4" width="190" display="walk-speed-std" height="50" min="0" direction="Horizontal" default="0.2" variable="walk-speed-std" units="s"></slider>
    <slider x="9" step="1" y="462" max="30" width="190" display="off-peak-rate" height="50" min="0" direction="Horizontal" default="20.0" variable="off-peak-rate" units="per minute"></slider>
    <slider x="9" step="30" y="517" max="600" width="190" display="lane-discipline-seconds" height="50" min="0" direction="Horizontal" default="90.0" variable="lane-discipline-seconds" units="s"></slider>
  </widgets>
  <info>## MINIMAL CALIBRATION MODEL

Stripped-back escalator model for verifying core throughput mechanics.

### What's included
- Arrival (demand pool + spawn)
- Approach (Dijkstra pathfinding)
- Boarding (step-gap cooldown only, no patience)
- Movement (escalator carry + walker extra steps)
- Exit

### What's excluded
- Patience / lane-switching on escalator
- Social influence
- Variable walk speeds (fixed at 1 extra step/tick)
- Stagger rule

### Key parameters
- **batch-size**: passengers per train (fixed, no min/max range)
- **train-interval-minutes**: fixed interval between trains
- **step-gap-stand / step-gap-walk**: boarding cooldown per lane
- **pct-walkers**: 0% = standing-only, 40% = baseline

### Calibration targets
- 40% walkers, demand-limited: Rush Hr ≈ 2,550
- 0% walkers, demand-limited: Rush Hr ≈ 3,250
- Avg peak throughput (mixed): ~80 pax/min
- Avg peak throughput (standing): ~110 pax/min</info>
